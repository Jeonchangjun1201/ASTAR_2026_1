.btn-blue {
    background-color: rgb(0, 42, 255);
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-left-color: rgb(0, 39, 255);
    border-right-color: rgb(0, 39, 255);
    border-top-color: rgb(0, 39, 255);
    border-bottom-color: rgb(0, 39, 255);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    transition-duration: 0.3s;
    scale: 1 1;
    margin-top: 10px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.btn-blue.ez {
    background-color: rgb(81, 85, 255);
}

.btn-blue:hover {
    background-color: rgb(81, 85, 255);
    rotate: 0;
}

.Pop-up-Window {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    color: rgb(127, 111, 111);
    background-color: rgba(177, 177, 177, 0.68);
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition-duration: 0.4s;
}

.Pop-up-Container {
    width: 800px;
    height: 600px;
    background-color: rgb(255, 255, 255);
    translate: 0 -200%;
}

.Pop-up-Window.open {
    visibility: visible;
    opacity: 1;
    transition-duration: 0.3s;
}

.Pop-up-Window.open > .Pop-up-Container {
    translate: 0 0;
    transition-duration: 0.5s;
}
